# Copy to ".env" and fill in. The floor plan works with NO keys.
PORT=3000

# OpenAI — required for AI renders + design scheme
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
# gpt-image-1 needs your OpenAI ORG VERIFIED. Cheaper: gpt-image-1-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# Optional web image search
UNSPLASH_ACCESS_KEY=
