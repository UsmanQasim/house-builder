# Copy to ".env" and fill in. Floor plan + 3D walkthrough work with NO keys.

PORT=3000

# --- OpenAI (optional but recommended for AI design + photoreal renders) ---
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
# gpt-image-1 needs your OpenAI org VERIFIED. Cheaper alternative: gpt-image-1-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# --- Unsplash (optional — web inspiration search in the sidebar) ---
# Free key: https://unsplash.com/oauth/applications
UNSPLASH_ACCESS_KEY=
