# Copy to ".env" and fill in.

PORT=3000

# --- OpenAI (floor plan picker, design scheme, renders) ---
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o
OPENAI_PLAN_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=gpt-image-1

# --- Optional paid upgrade (NOT required — DuckDuckGo is used free by default) ---
# BRAVE_SEARCH_API_KEY=

# --- Real 3D furniture models (FREE key — makes the 3D look far better) ---
# Get a free hobby key at https://poly.pizza  ->  sign up  ->  API.
# With this set, rooms load real CC0 furniture (sofas, beds, chairs, etc.)
# instead of simple shapes. Without it, the built-in procedural furniture is used.
POLY_PIZZA_KEY=

# --- Optional interior inspiration images ---
UNSPLASH_ACCESS_KEY=
