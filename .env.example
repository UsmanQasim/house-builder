# Copy to ".env" and fill in.

PORT=3000

# Cost controls for deployed demos. APP_ACCESS_TOKEN is optional; when set,
# paid AI POST routes require it as a Bearer or X-App-Token header.
AI_RATE_LIMIT_PER_HOUR=30
# Set to 1 for a reliable offline demo or whenever provider credentials fail.
AI_OFFLINE=0
# APP_ACCESS_TOKEN=
# Only enable behind a trusted reverse proxy that overwrites X-Forwarded-For.
# TRUST_PROXY=0

# ============ PROVIDERS ============
# Images (photoreal renders + AI floor-plan renders):
#   default = Nano Banana Pro (Gemini) when GEMINI_API_KEY is set, else OpenAI.
#   Force one with: IMAGE_PROVIDER=gemini | openai
# IMAGE_PROVIDER=gemini

# --- Google Gemini / Nano Banana Pro (reference-conditioned image generation) ---
GEMINI_API_KEY=
# Nano Banana Pro. Alternatives: gemini-3-1-flash-image (Nano Banana 2, faster/cheaper)
GEMINI_IMAGE_MODEL=gemini-3-pro-image
GEMINI_TEXT_MODEL=gemini-2.5-flash

# --- OpenAI (bespoke floor-plan reasoning, design schemes, vision; image fallback) ---
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-terra
OPENAI_PLAN_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=medium
OPENAI_IMAGE_MODEL=gpt-image-2

# --- Rodin by Hyper3D / Deemos (text-to-3D: generates high-quality furniture GLBs) ---
# Get a key at hyper3d.ai -> API. Each furniture type is generated ONCE, then cached.
RODIN_API_KEY=

# --- Free CC0 furniture fallback (poly.pizza -> sign up -> API) ---
POLY_PIZZA_KEY=

# --- Optional web search / inspiration ---
# BRAVE_SEARCH_API_KEY=
UNSPLASH_ACCESS_KEY=
