# ---------------------------------------------------------------------------
# House Builder MVP — environment variables
#
# Copy this file to ".env" and fill in ONLY the keys you actually want.
# The 3D house generator + virtual walkthrough work with NO keys at all.
# Everything below is optional and only powers extra features.
# ---------------------------------------------------------------------------

# Port the local server runs on
PORT=3000

# --- Reference images pulled from the internet (Unsplash) -------------------
# Free developer keys: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# --- AI design-image generation (pick ONE; wire up in server.js) ------------
# OpenAI (gpt-image-1 / DALL·E):  https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Stability AI:                   https://platform.stability.ai/account/keys
STABILITY_API_KEY=
# Replicate (many models):        https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# --- AI text-to-3D mesh (optional, future) ---------------------------------
# Meshy: https://www.meshy.ai/  (or Luma / Tripo)
MESHY_API_KEY=
