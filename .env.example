# Copy to ".env" and fill in.

PORT=3000

# ============ PROVIDERS ============
# Images (photoreal renders + AI floor-plan renders):
#   default = Nano Banana Pro (Gemini) when GEMINI_API_KEY is set, else OpenAI.
#   Force one with: IMAGE_PROVIDER=gemini | openai
# IMAGE_PROVIDER=gemini

# --- Google Gemini / Nano Banana Pro (best image quality; free tier at aistudio.google.com) ---
GEMINI_API_KEY=
# Nano Banana Pro. Alternatives: gemini-3-1-flash-image (Nano Banana 2, faster/cheaper)
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
GEMINI_TEXT_MODEL=gemini-2.5-flash

# --- OpenAI (bespoke floor-plan reasoning, design schemes, vision; image fallback) ---
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o
OPENAI_PLAN_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=gpt-image-1

# --- Rodin by Hyper3D / Deemos (text-to-3D: generates high-quality furniture GLBs) ---
# Get a key at hyper3d.ai -> API. Each furniture type is generated ONCE, then cached.
RODIN_API_KEY=

# --- Free CC0 furniture fallback (poly.pizza -> sign up -> API) ---
POLY_PIZZA_KEY=

# --- Optional web search / inspiration ---
# BRAVE_SEARCH_API_KEY=
UNSPLASH_ACCESS_KEY=
