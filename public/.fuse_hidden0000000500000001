/* ------------------------------- design ---------------------------------- */
function getDesign(){
  const base=DEFAULTS[cfg.style]||DEFAULTS.modern;
  const d={ roofType:base.roofType, exterior:Object.assign({},base.exterior), rooms:{} };
  for(const k in base.rooms){ const a=base.rooms[k]; d.rooms[k]={floor:a[0],wall:a[1],accent:a[2]}; }
  if(useAI && aiBrief){
    if(aiBrief.exterior) Object.assign(d.exterior, clean(aiBrief.exterior));
    const rs=aiBrief.roomStyles||{};
    for(const k in d.rooms){ const r=rs[k]; if(r){ if(ok(r.floorHex))d.rooms[k].floor=r.floorHex; if(ok(r.wallHex))d.rooms[k].wall=r.wallHex; if(ok(r.accentHex))d.rooms[k].accent=r.accentHex; } }
  }
  return d;
}
const ok=h=>typeof h==='string'&&/^#?[0-9a-fA-F]{6}$/.test(h.trim());
function clean(o){const r={};for(const k in o)if(ok(o[k]))r[k]=o[k].trim();return r;}
function floorKind(type){ return (type==='kitchen'||type==='bathroom')?'tile':type==='garage'?'concrete':type==='bedroom'?'carpet':'wood'; }

/* --------------------------- room distribution --------------------------- */
function distribute(c){
  const floors=Array.from({length:c.floors},()=>[]);
  const add=(f,type,name,w)=>floors[f].push({type,name,weight:w});
  for(let i=0;i<c.living;i++) add(0,'living',c.living>1?'Living '+(i+1):'Living Room',3.4);
  if(c.dining) add(0,'dining','Dining',2.3);
  for(let i=0;i<c.kitchens;i++) add(0,'kitchen',c.kitchens>1?'Kitchen '+(i+1):'Kitchen',2.4);
  if(c.garage) add(0,'garage','Garage',2.7);
  const bedStart=c.floors>1?1:0, upper=Math.max(1,c.floors-bedStart);
  for(let i=0;i<c.bedrooms;i++) add(bedStart+(i%upper),'bedroom',i===0?'Master Bedroom':'Bedroom '+(i+1),i===0?3.3:2.7);
  for(let i=0;i<c.bathrooms;i++){ const f=i===0?0:bedStart+((i-1)%upper); add(f,'bathroom',c.bathrooms>1?'Bath '+(i+1):'Bathroom',1.2); }
  for(let f=0;f<floors.length;f++) if(floors[f].length===0) add(f,'room','Room',2.2);
  return floors;
}

/* --------------------- intelligent central-corridor layout --------------- */
function computeLayout(c){
  const margin=Math.min(c.plotW,c.plotD)*0.14; const mg=Math.max(1.2,Math.min(3.2,margin));
  const FW=Math.max(5,c.plotW-2*mg), FD=Math.max(5,c.plotD-2*mg);
  const minX=-FW/2,maxX=FW/2,minZ=-FD/2,maxZ=FD/2;
  let CW=Math.max(1.1,Math.min(1.8,FW*0.12)); if((FW-CW)/2<1.9) CW=Math.max(0.9,FW-3.8);
  const sideW=(FW-CW)/2;
  const rf=distribute(c);
  const floors=rf.map((rooms,idx)=>{
    if(rooms.length===1){ rooms[0].rect={x:minX,z:minZ,w:FW,d:FD}; return {index:idx,corridor:null,rooms,left:[rooms[0]],right:[]}; }
    const left=[],right=[]; rooms.forEach((r,i)=>(i%2===0?left:right).push(r));
    if(right.length===0){right.push(left.pop());}
    sliceZ(left,minX,sideW,minZ,maxZ); sliceZ(right,CW/2,sideW,minZ,maxZ);
    return {index:idx,corridor:{x:-CW/2,z:minZ,w:CW,d:FD},rooms,left,right};
  });
  return {FW,FD,CW,minX,maxX,minZ,maxZ,sideW,foot:{x:minX,z:minZ,w:FW,d:FD},floors};
}
function sliceZ(list,x0,w,zMin,zMax){ const tot=list.reduce((s,r)=>s+r.weight,0); let cur=zMax;
  list.forEach(r=>{ const d=(zMax-zMin)*r.weight/tot; r.rect={x:x0,z:cur-d,w,d}; cur-=d; }); }

/* ------------------------------- build 3D -------------------------------- */
function build(){
  if(root) scene.remove(root);
  root=new THREE.Group(); scene.add(root);
  roofGroup=new THREE.Group(); floorGroups=[]; ceilGroups=[]; wallBoxesByFloor=[];
  const D=getDesign(), ext=D.exterior;

  const yard=9, gw=cfg.plotW+yard, gd=cfg.plotD+yard; bounds={x:gw/2-0.5,z:gd/2-0.5};
  const grass=new THREE.Mesh(new THREE.PlaneGeometry(gw,gd), texMat('grass','#86a566',gw/4,gd/4,0.95));
  grass.rotation.x=-Math.PI/2; grass.position.y=0; grass.receiveShadow=true; root.add(grass);
  box(root,cfg.plotW,0.06,cfg.plotD,solid('#6f7f54',0.95),0,0.04,0);
  box(root,L.FW+0.7,0.3,L.FD+0.7,solid('#9a948a',0.9),0,0.15,0);
  box(root,2.0,0.05,yard/2+1.2,solid('#c7c1b4',0.85),0,0.18,L.FD/2+yard/4);
  if(cfg.garage) box(root,3.4,0.05,gd/2-L.FD/2,solid('#6f6f6f',0.9),L.FW*0.28,0.18,L.FD/2+(gd/2-L.FD/2)/2);
  trees(root,gw,gd);
  box(root,FRONTW+0.6,0.18,0.7,solid(ext.trimHex,0.7),0,0.09,L.FD/2+0.35);

  const halfW=L.FW/2, halfD=L.FD/2, wallH=cfg.wallH;
  for(let f=0;f<cfg.floors;f++){
    const yB=f*(wallH+SLAB), fg=new THREE.Group(); floorGroups[f]=fg; root.add(fg);
    const cg=new THREE.Group(); ceilGroups[f]=cg; root.add(cg); wallBoxesByFloor[f]=[];
    const fl=L.floors[f];

    [...fl.left,...fl.right].forEach(r=>{ roomFloor(fg,r,yB,D); interior(fg,r,yB,wallH,D); });
    if(fl.corridor){ const co=fl.corridor; box(fg,co.w,SLAB,co.d,texMat('wood',D.rooms.corridor.floor,1,Math.max(1,co.d/2)),0,yB-SLAB/2,0);
      box(fg,co.w*0.6,0.02,co.d*0.82,solid(D.rooms.corridor.accent,0.95),0,yB+0.012,0,0,false); }

    const wallMat=texMat('paint',ext.wallHex,3,1.2,0.9), trim=ext.trimHex;
    if(f===0) wallGaps(fg,'x',halfD,-halfW,halfW,[0],OT,yB,wallH,wallMat,solid(ext.doorHex,0.5),f,FRONTW);
    else seg(fg,-halfW,halfD,halfW,halfD,OT,yB,wallH,wallMat,f);
    seg(fg,-halfW,-halfD,halfW,-halfD,OT,yB,wallH,wallMat,f);
    seg(fg,-halfW,-halfD,-halfW,halfD,OT,yB,wallH,wallMat,f);
    seg(fg,halfW,-halfD,halfW,halfD,OT,yB,wallH,wallMat,f);

    if(fl.corridor){
      const lc=-L.CW/2, rc=L.CW/2;
      wallGaps(fg,'z',lc,-halfD,halfD, fl.left.map(r=>r.rect.z+r.rect.d/2), IT,yB,wallH, texMat('paint',D.rooms.corridor.wall,1,1,0.9), solid(trim,0.6), f, DOORW);
      wallGaps(fg,'z',rc,-halfD,halfD, fl.right.map(r=>r.rect.z+r.rect.d/2), IT,yB,wallH, texMat('paint',D.rooms.corridor.wall,1,1,0.9), solid(trim,0.6), f, DOORW);
      dividers(fg,fl.left,-halfW,lc,yB,wallH,ext.wallHex,f);
      dividers(fg,fl.right,rc,halfW,yB,wallH,ext.wallHex,f);
    }
