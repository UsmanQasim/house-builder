/* ------------------------- procedural textures --------------------------- */
function canvasTex(size, draw, rx, ry) {
  const c=document.createElement('canvas'); c.width=c.height=size;
  draw(c.getContext('2d'), size);
  const t=new THREE.CanvasTexture(c); t.wrapS=t.wrapT=THREE.RepeatWrapping;
  t.repeat.set(rx||1, ry||1); t.encoding=THREE.sRGBEncoding; t.anisotropy=4;
  return t;
}
function noise(ctx,s,amt){ const img=ctx.getImageData(0,0,s,s),d=img.data;
  for(let i=0;i<d.length;i+=4){const n=(Math.random()-0.5)*amt; d[i]+=n;d[i+1]+=n;d[i+2]+=n;} ctx.putImageData(img,0,0); }
function texFor(kind){ if(texCache.has(kind)) return texCache.get(kind); let t;
  if(kind==='wood') t=canvasTex(512,(c,s)=>{ const pw=64;
      for(let x=0;x<s;x+=pw){ const g=176+Math.random()*30-15; c.fillStyle='rgb('+g+','+g+','+g+')'; c.fillRect(x,0,pw,s);
        c.strokeStyle='rgba(120,120,120,.35)'; c.beginPath(); c.moveTo(x,0); c.lineTo(x,s); c.stroke();
        for(let k=0;k<14;k++){ const a=110+Math.random()*40,b=110+Math.random()*40,d2=110+Math.random()*40; c.strokeStyle='rgba('+a+','+b+','+d2+',.18)';
          c.beginPath(); const yy=Math.random()*s; c.moveTo(x,yy); c.bezierCurveTo(x+pw*0.4,yy+8,x+pw*0.6,yy-8,x+pw,yy+Math.random()*6); c.stroke(); } }
      for(let y=0;y<s;y+=170){ c.strokeStyle='rgba(90,90,90,.4)'; c.beginPath(); c.moveTo(0,y); c.lineTo(s,y); c.stroke(); } },1,1);
  else if(kind==='tile') t=canvasTex(512,(c,s)=>{ c.fillStyle='#cfcfcf'; c.fillRect(0,0,s,s); const ts=128;
      for(let x=0;x<s;x+=ts)for(let y=0;y<s;y+=ts){ const g=205+Math.random()*30-15; c.fillStyle='rgb('+g+','+g+','+g+')'; c.fillRect(x+2,y+2,ts-4,ts-4); }
      c.strokeStyle='#8f8f8f'; c.lineWidth=4; for(let x=0;x<=s;x+=ts){c.beginPath();c.moveTo(x,0);c.lineTo(x,s);c.stroke();c.beginPath();c.moveTo(0,x);c.lineTo(s,x);c.stroke();} },1,1);
  else if(kind==='carpet') t=canvasTex(256,(c,s)=>{ c.fillStyle='#cccccc'; c.fillRect(0,0,s,s); noise(c,s,46); },1,1);
  else if(kind==='concrete') t=canvasTex(256,(c,s)=>{ c.fillStyle='#b9b9b9'; c.fillRect(0,0,s,s); noise(c,s,30);
      for(let k=0;k<6;k++){c.strokeStyle='rgba(120,120,120,.25)';c.beginPath();c.moveTo(Math.random()*s,0);c.lineTo(Math.random()*s,s);c.stroke();} },1,1);
  else if(kind==='paint') t=canvasTex(256,(c,s)=>{ c.fillStyle='#ededed'; c.fillRect(0,0,s,s); noise(c,s,10); },1,1);
  else if(kind==='grass') t=canvasTex(256,(c,s)=>{ c.fillStyle='#7c9b5e'; c.fillRect(0,0,s,s);
      for(let k=0;k<2600;k++){const a=70+Math.random()*60,b=110+Math.random()*70,d2=60+Math.random()*40; c.fillStyle='rgba('+a+','+b+','+d2+',.5)';c.fillRect(Math.random()*s,Math.random()*s,2,3);} },1,1);
  else t=canvasTex(8,(c,s)=>{c.fillStyle='#cfcfcf';c.fillRect(0,0,s,s);});
  texCache.set(kind,t); return t;
}
function texMat(kind, hex, rx, ry, rough){
  const key=kind+hex+rx+'x'+ry; if(matCache.has(key)) return matCache.get(key);
  const base=texFor(kind), t=base.clone(); t.needsUpdate=true; t.repeat.set(rx,ry);
  const m=new THREE.MeshStandardMaterial({ map:t, color:hx(hex), roughness:rough==null?0.82:rough, metalness:0.02 });
  matCache.set(key,m); return m;
}
function solid(hex, rough, metal){ const key='s'+hex+rough+metal; if(matCache.has(key)) return matCache.get(key);
  const m=new THREE.MeshStandardMaterial({color:hx(hex),roughness:rough==null?0.7:rough,metalness:metal||0}); matCache.set(key,m); return m; }
function glassMat(){ if(matCache.has('glass')) return matCache.get('glass');
  const m=new THREE.MeshStandardMaterial({color:0xbfe0f5,transparent:true,opacity:0.22,roughness:0.04,metalness:0,envMapIntensity:1.5}); matCache.set('glass',m); return m; }

/* ------------------------------- geometry helpers ------------------------ */
function box(group,w,h,d,material,x,y,z,ry,shadow){
  const m=new THREE.Mesh(new THREE.BoxGeometry(w,h,d), typeof material==='number'?solid('#'+material.toString(16)):material);
  m.position.set(x,y,z); if(ry)m.rotation.y=ry;
  if(shadow!==false){m.castShadow=true;m.receiveShadow=true;} group.add(m); return m;
}
function seg(group,ax,az,bx,bz,thick,yB,h,material,cf){
  let cx,cz,w,d;
  if(Math.abs(az-bz)<1e-6){cx=(ax+bx)/2;cz=az;w=Math.abs(bx-ax)||thick;d=thick;}
  else{cx=ax;cz=(az+bz)/2;w=thick;d=Math.abs(bz-az)||thick;}
  if(w<1e-4||d<1e-4)return; box(group,w,h,d,material,cx,yB+h/2,cz);
  if(cf!=null)(wallBoxesByFloor[cf]||(wallBoxesByFloor[cf]=[])).push({minX:cx-w/2,maxX:cx+w/2,minZ:cz-d/2,maxZ:cz+d/2});
}
/* wall with door gaps (gaps: array of center positions along the run) + frames */
function wallGaps(group,axis,fixed,from,to,gaps,thick,yB,wallH,mat,frameMat,cf,gw){
  const pts=[from]; gaps.forEach(c=>{pts.push(c-gw/2,c+gw/2);}); pts.push(to);
  for(let i=0;i<pts.length;i+=2){ const a=pts[i],b=pts[i+1]; if(b-a<0.02) continue;
    if(axis==='z') seg(group,fixed,a,fixed,b,thick,yB,wallH,mat,cf); else seg(group,a,fixed,b,fixed,thick,yB,wallH,mat,cf); }
  gaps.forEach(c=>{
    if(axis==='z'){ seg(group,fixed,c-gw/2,fixed,c+gw/2,thick,yB+DOORH,wallH-DOORH,mat,null);
      box(group,thick+0.04,DOORH,0.06,frameMat,fixed,yB+DOORH/2,c-gw/2,0,false); box(group,thick+0.04,DOORH,0.06,frameMat,fixed,yB+DOORH/2,c+gw/2,0,false); }
    else{ seg(group,c-gw/2,fixed,c+gw/2,fixed,thick,yB+DOORH,wallH-DOORH,mat,null);
      box(group,0.06,DOORH,thick+0.04,frameMat,c-gw/2,yB+DOORH/2,fixed,0,false); box(group,0.06,DOORH,thick+0.04,frameMat,c+gw/2,yB+DOORH/2,fixed,0,false); } });
}
function windowOn(group,axis,fixed,center,zspan,yB,wallH,trimHex){
  const sill=yB+0.95, wh=Math.min(1.25,wallH-1.4), ww=Math.min(1.5,zspan-0.6); if(ww<0.5)return;
  const g=glassMat(), fm=solid(trimHex,0.6);
  if(axis==='z'){ box(group,0.05,wh,ww,g,fixed,sill+wh/2,center,0,false);
    box(group,0.09,wh+0.14,ww+0.14,fm,fixed,sill+wh/2,center,0,false);
    box(group,0.12,0.08,ww+0.2,fm,fixed,sill-0.02,center,0,false); }
  else{ box(group,ww,wh,0.05,g,center,sill+wh/2,fixed,0,false);
    box(group,ww+0.14,wh+0.14,0.09,fm,center,sill+wh/2,fixed,0,false);
    box(group,ww+0.2,0.08,0.12,fm,center,sill-0.02,fixed,0,false); }
}

