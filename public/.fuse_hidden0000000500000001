    const r=await fetch('/api/ai/design-image',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({style:cfg.style,room,notes})});
    const d=await r.json(); if(!r.ok) throw new Error(d.error||'Failed');
    const src=d.b64?('data:image/png;base64,'+d.b64):d.url; const im=document.createElement('img'); im.src=src; im.title=room; im.onclick=()=>window.open(src,'_blank');
    cell.replaceWith(im);
  }catch(e){ cell.innerHTML='<span style="font-size:10px;padding:4px;text-align:center">'+e.message+'</span>'; toast('Render: '+e.message); } finally{ hideLoading(); } }

/* ------------------------------- reference imgs -------------------------- */
function addThumb(url,link){ const im=document.createElement('img'); im.src=url; im.onclick=()=>window.open(link||url,'_blank'); $('refStrip').appendChild(im); }
function wireRefs(){ $('uploadBtn').onclick=()=>$('fileInput').click();
  $('fileInput').onchange=e=>{ for(const f of e.target.files) addThumb(URL.createObjectURL(f)); };
  $('netBtn').onclick=()=>{ const w=$('netQueryWrap'); w.style.display=w.style.display==='none'?'block':'none'; if(w.style.display==='block')$('netQuery').focus(); };
  $('netQuery').addEventListener('keydown',async e=>{ if(e.key!=='Enter')return; const q=e.target.value.trim(); if(!q)return; toast('Searching...');
    try{ const r=await fetch('/api/reference-images?q='+encodeURIComponent(q)); const d=await r.json(); if(!r.ok)return toast(d.error||'Unavailable');
      (d.images||[]).forEach(i=>addThumb(i.thumb,i.link)); toast('Added '+(d.images||[]).length+' images'); }catch(_){ toast('Could not reach server'); } }); }

/* ------------------------------- export ---------------------------------- */
function download(blob,name){ const a=document.createElement('a'); a.href=URL.createObjectURL(blob); a.download=name; a.click(); setTimeout(()=>URL.revokeObjectURL(a.href),4000); }
function exportPNG(){ const c=document.createElement('canvas'); c.width=858; c.height=642; drawPlan(c.getContext('2d'),286,214,3,currentFloor); c.toBlob(b=>download(b,'floorplan-L'+(currentFloor+1)+'.png')); }
function exportGLB(){ if(!root)return; toast('Exporting 3D model...'); new THREE.GLTFExporter().parse(root,res=>{ download(new Blob([res],{type:'model/gltf-binary'}),'house-model.glb'); toast('Saved house-model.glb'); },{binary:true}); }
function wireExport(){ const btn=$('exportBtn'), menu=document.createElement('div');
  menu.style.cssText='position:absolute;top:52px;right:16px;background:#1c212b;border:1px solid #2b3340;border-radius:11px;padding:7px;display:none;z-index:20;box-shadow:0 10px 30px rgba(0,0,0,.4)';
  [['Download floor plan (PNG)',exportPNG],['Download 3D model (GLB)',exportGLB]].forEach(pair=>{ const b=document.createElement('button'); b.className='ghost'; b.textContent=pair[0]; b.style.cssText='display:block;width:214px;margin:4px 0;text-align:left'; b.onclick=()=>{menu.style.display='none';pair[1]();}; menu.appendChild(b); });
  document.querySelector('main').appendChild(menu); btn.onclick=()=>{ menu.style.display=menu.style.display==='none'?'block':'none'; }; }

/* ------------------------------- toast ----------------------------------- */
let tT; function toast(m){ const t=$('toast'); t.textContent=m; t.style.opacity='1'; clearTimeout(tT); tT=setTimeout(()=>t.style.opacity='0',2800); }

/* ------------------------------- chips ----------------------------------- */
function wireChip(id,chipId){ const cb=$(id); const sync=()=>$(chipId).classList.toggle('on',cb.checked); $(chipId).addEventListener('click',()=>setTimeout(sync,0)); sync(); }

/* ------------------------------- boot ------------------------------------ */
function randomize(){ $('plotW').value=12+Math.floor(Math.random()*18); $('plotD').value=10+Math.floor(Math.random()*14);
  $('floors').value=1+Math.floor(Math.random()*3); $('bedrooms').value=1+Math.floor(Math.random()*5); $('bathrooms').value=1+Math.floor(Math.random()*3);
  $('kitchens').value=1; $('living').value=1+Math.floor(Math.random()*2); $('dining').checked=Math.random()>0.3; $('garage').checked=Math.random()>0.4;
  $('style').value=['modern','traditional','minimalist','scandinavian','industrial'][Math.floor(Math.random()*5)];
  $('diningChip').classList.toggle('on',$('dining').checked); $('garageChip').classList.toggle('on',$('garage').checked); updateArea(); generate(); }
function boot(){ init(); wireRefs(); wireExport(); wireChip('dining','diningChip'); wireChip('garage','garageChip');
  $('generateBtn').onclick=generate; $('randomBtn').onclick=randomize;
  $('resetCamBtn').onclick=()=>{ if(mode==='orbit')frameOrbit(); else placePlayer(currentFloor); };
  document.querySelectorAll('#viewSeg button').forEach(b=>b.onclick=()=>setMode(b.dataset.mode));
  $('cutawayBtn').onclick=()=>{ cutaway=!cutaway; $('cutawayBtn').textContent='Cutaway: '+(cutaway?'on':'off'); applyVisibility(); };
  ['plotW','plotD'].forEach(id=>$(id).addEventListener('input',updateArea));
  $('planHead').onclick=()=>$('planWrap').classList.toggle('collapsed');
  $('briefBtn').onclick=genBrief; $('inspBtn').onclick=genImage;
  $('applyPalette').addEventListener('change',()=>{ useAI=$('applyPalette').checked&&!!aiBrief; if(aiBrief){build();setFloor(currentFloor);} });
  updateArea(); generate(); checkAI();
}
boot();
})();
