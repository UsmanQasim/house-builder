/* ------------------------------- animate --------------------------------- */
const _f=new THREE.Vector3(),_r=new THREE.Vector3(),_up=new THREE.Vector3(0,1,0);
function animate(){ requestAnimationFrame(animate); const dt=Math.min(clock.getDelta(),0.05);
  if(mode==='walk'&&plControls.isLocked){
    const sp=((keys['ShiftLeft']||keys['ShiftRight'])?7.2:3.7)*dt;
    const fwd=(keys['KeyW']||keys['ArrowUp']?1:0)-(keys['KeyS']||keys['ArrowDown']?1:0);
    const str=(keys['KeyD']||keys['ArrowRight']?1:0)-(keys['KeyA']||keys['ArrowLeft']?1:0);
    if(fwd||str){ camera.getWorldDirection(_f); _f.y=0; _f.normalize(); _r.crossVectors(_f,_up).normalize();
      let mx=_f.x*fwd+_r.x*str, mz=_f.z*fwd+_r.z*str; const l=Math.hypot(mx,mz)||1; mx=mx/l*sp; mz=mz/l*sp;
      const o=plControls.getObject(), bx=wallBoxesByFloor[currentFloor]||[];
      let nx=o.position.x+mx; if(!noClip&&hit(nx,o.position.z,bx))nx=o.position.x;
      let nz=o.position.z+mz; if(!noClip&&hit(nx,nz,bx))nz=o.position.z;
      o.position.x=Math.max(-bounds.x,Math.min(bounds.x,nx)); o.position.z=Math.max(-bounds.z,Math.min(bounds.z,nz));
      o.position.y=currentFloor*(cfg.wallH+SLAB)+EYE; }
  } else if(mode==='orbit') orbit.update();
  renderer.render(scene,camera);
}
function hit(x,z,b){ for(let i=0;i<b.length;i++){const w=b[i]; if(x>w.minX-PR&&x<w.maxX+PR&&z>w.minZ-PR&&z<w.maxZ+PR)return true;} return false; }

