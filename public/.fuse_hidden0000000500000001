function drawPlan(ctx,W,H,ratio,f){ ctx.save(); ctx.scale(ratio,ratio); ctx.clearRect(0,0,W,H);
  ctx.fillStyle='#0a0c10'; ctx.fillRect(0,0,W,H); if(!L){ctx.restore();return;}
  const pad=16, s=Math.min((W-2*pad)/cfg.plotW,(H-2*pad)/cfg.plotD), ox=W/2, oz=H/2;
  const X=x=>ox+x*s, Z=z=>oz+z*s, D=getDesign();
  ctx.strokeStyle='#37414f'; ctx.lineWidth=1; ctx.strokeRect(X(-cfg.plotW/2),Z(-cfg.plotD/2),cfg.plotW*s,cfg.plotD*s);
  const fl=L.floors[f];
  if(fl.corridor){ ctx.fillStyle='#1c222c'; ctx.fillRect(X(fl.corridor.x),Z(fl.corridor.z),fl.corridor.w*s,fl.corridor.d*s); }
  ctx.font='9px sans-serif'; ctx.textAlign='center';
  [...fl.left,...fl.right].forEach(r=>{ const R=r.rect, ds=D.rooms[r.type];
    ctx.fillStyle=ds?ds.wall:'#444'; ctx.globalAlpha=0.9; ctx.fillRect(X(R.x),Z(R.z),R.w*s,R.d*s); ctx.globalAlpha=1;
    ctx.strokeStyle='#0a0c10'; ctx.lineWidth=2; ctx.strokeRect(X(R.x),Z(R.z),R.w*s,R.d*s);
    if(R.w*s>34&&R.d*s>22){ ctx.fillStyle='#20242b'; ctx.fillText(r.name,X(R.x+R.w/2),Z(R.z+R.d/2)-1);
      ctx.fillStyle='#3a4250'; ctx.font='8px sans-serif'; ctx.fillText((R.w*R.d).toFixed(0)+' m2',X(R.x+R.w/2),Z(R.z+R.d/2)+9); ctx.font='9px sans-serif'; } });
  ctx.strokeStyle='#fff'; ctx.lineWidth=2; ctx.strokeRect(X(L.minX),Z(L.minZ),L.FW*s,L.FD*s);
  if(f===0){ ctx.fillStyle='#34d0a4'; ctx.fillRect(X(-FRONTW/2),Z(L.maxZ)-2,FRONTW*s,4); }
  ctx.fillStyle='#94a1b4'; ctx.textAlign='left'; ctx.fillText('N + '+cfg.plotW+'x'+cfg.plotD+' m',8,13); ctx.restore();
}

